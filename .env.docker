# ==========================================
# Database Configuration (Internal Docker Network)
# ==========================================
DB_NAME=localragvault
DB_USER=postgres
DB_PASSWORD=localragvault_secure_pass
DB_HOST=db
DB_PORT=5432

# ==========================================
# Ollama & Host AI Configuration
# ==========================================
# Routes out of the Docker bridge network to your native OS Ollama daemon
OLLAMA_BASE_URL=http://host.docker.internal:11434
ALLOW_CLOUD_MODELS=False
MAX_FILE_SIZE_MB=25

# ==========================================
# Backend API URL (For Streamlit UI)
# ==========================================
# In Docker, Streamlit must communicate with FastAPI via internal DNS
API_BASE_URL=http://api:8000

# ==========================================
# Model Defaults & RAG Hyperparameters
# ==========================================
DEFAULT_EMBEDDING_MODEL=embeddinggemma:latest
DEFAULT_GENERATION_MODEL=gemma4:latest
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.15
DEFAULT_CHAT_HISTORY_LIMIT=10
